+def _has_raw_mode(less_env: str, cmd_params: list[str]) -> bool:
+    """Check if raw mode (-R / --RAW-CONTROL-CHARS) is enabled in less options.
+
+    Parses both LESS environment variable and command-line arguments to properly
+    detect raw mode flags while ignoring filenames and option values.
+    """
+    options = []
+
+    # Parse LESS environment variable
+    if less_env:
+        try:
+            options.extend(shlex.split(less_env))
+        except ValueError:
+            # Unbalanced quotes: fall back to whitespace splitting
+            options.extend(less_env.split())
+
+    # Parse command-line parameters, stopping at option terminator '--'
+    for param in cmd_params:
+        if param == "--":
+            break
+        if param.startswith("-"):
+            options.append(param)
+
+    # Check if any option enables raw mode
+    for opt in options:
+        if opt == "-R":
+            return True
+        if opt == "--RAW-CONTROL-CHARS":
+            return True
+        # Check for --RAW-CONTROL-CHARS=... form
+        if opt.startswith("--RAW-CONTROL-CHARS="):
+            return True
+        # Check for bundled short options like -rX or -Xr
+        if opt.startswith("-") and not opt.startswith("--"):
+            if "r" in opt or "R" in opt:
+                # Verify it's a bundled option (not a value starting with r/R)
+                # by checking if there are other letters
+                letters = [c for c in opt[1:] if c.isalpha()]
+                if letters and ("r" in letters or "R" in letters):
+                    return True
+
+    return False
+
