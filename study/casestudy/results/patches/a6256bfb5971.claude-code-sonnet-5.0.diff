+def _is_less(cmd_path: Path) -> bool:
+    """Check whether ``cmd_path`` resolves to ``less``, matching the command
+    stem so ``less.exe`` is recognized the same as a bare ``less``.
+
+    Windows filesystems are case-insensitive, so a Windows-resolved path is
+    matched case-insensitively there. POSIX keeps an exact, case-sensitive
+    match.
+    """
+    stem = cmd_path.stem
+
+    if WIN:
+        stem = stem.casefold()
+
+    return stem == "less"
+
