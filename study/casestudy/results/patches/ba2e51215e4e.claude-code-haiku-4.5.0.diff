+def form_encoded(string: str, safe: str = "") -> str:
+    """
+    Use form encoding (application/x-www-form-urlencoded) to encode a string.
+    Spaces are encoded as '+', unreserved characters and additional safe chars are not encoded.
+    """
+    NON_ESCAPED_CHARS = UNRESERVED_CHARACTERS + ":/?." + safe
+
+    if not string:
+        return string
+
+    result = []
+    for char in string:
+        if char == ' ':
+            result.append('+')
+        elif char in NON_ESCAPED_CHARS:
+            result.append(char)
+        else:
+            result.append(PERCENT(char))
+
+    return ''.join(result)
+
