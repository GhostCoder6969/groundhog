+    def converter(self, meth):
+        """
+        Decorator that sets *meth* as the converter for this attribute.
+
+        If a converter is already set, the new one is composed with the old
+        one using `attrs.converters.pipe`.
+
+        The wrapped method is passed the partially initialized instance,
+        the `attrs.Attribute` for this attribute, and the value, in that
+        order -- mirroring the signature used by the *validator* decorator.
+
+        Returns *meth* unchanged.
+
+        .. versionadded:: 25.1.0
+        """
+
+        def convert(value, instance, field):
+            return meth(instance, field, value)
+
+        new_converter = Converter(convert, takes_self=True, takes_field=True)
+        if self._converter is None:
+            self._converter = new_converter
+        else:
+            self._converter = pipe(self._converter, new_converter)
+        return meth
+
