+class _PagerWriter:
+    """Wraps a stream to strip ANSI codes when color=False and manage lifecycle.
+
+    The pager's close() method flushes but does not close the underlying stream,
+    allowing the caller to manage its lifecycle.
+    """
+
+    def __init__(self, stream: t.TextIO, *, color: bool):
+        self.stream = stream
+        self.color = color
+
+    def write(self, text: str) -> int:
+        if not self.color:
+            text = strip_ansi(text)
+        return self.stream.write(text)
+
+    def flush(self) -> None:
+        self.stream.flush()
+
+    def close(self) -> None:
+        # Flush but don't close; the stream's owner manages its lifecycle.
+        self.flush()
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self.stream, name)
