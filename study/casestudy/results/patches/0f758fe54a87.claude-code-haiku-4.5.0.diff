-        self.converter = converter
+        self._converter = converter
         self.repr = repr
         self.eq = eq
         self.eq_key = eq_key
@@ -2840,6 +2840,37 @@ class _CountingAttr:
 
         return meth
 
+    def converter(self, meth):
+        """
+        Decorator that adds *meth* as a converter.
+
+        If no converter is set, the method is used directly.
+        If a converter is already set, they are composed with `pipe`.
+
+        Returns *meth* unchanged.
+
+        .. versionadded:: 25.4.0
+        """
+        sig = inspect.signature(meth)
+        params = list(sig.parameters.keys())
+
+        takes_self = bool(params and params[0] == "self")
+        takes_field = "field" in params
+
+        if takes_self and takes_field:
+            def wrapper(value, instance, field):
+                return meth(instance, field, value)
+            converter = Converter(wrapper, takes_self=True, takes_field=True)
+        else:
+            converter = Converter(meth, takes_self=takes_self, takes_field=takes_field)
+
+        if self._converter is None:
+            self._converter = converter
+        else:
+            self._converter = pipe(self._converter, converter)
+
+        return meth
+
 
 _CountingAttr = _add_eq(_add_repr(_CountingAttr))
 
