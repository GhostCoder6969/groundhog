+def _fast_exit(code: int) -> t.NoReturn:
+    """Call ``sys.exit`` until it actually exits.
+
+    A ``KeyboardInterrupt`` arriving while ``sys.exit`` is unwinding must not
+    replace the exit code that was already decided.
+    """
+    while True:
+        try:
+            sys.exit(code)
+        except KeyboardInterrupt:
+            continue
+
