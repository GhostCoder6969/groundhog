+class _IteratorToAsyncIterator(t.Generic[V]):
+    """Adapt a sync iterable to the async iterator protocol without
+    using an async generator function. A real async generator would be
+    tracked by the interpreter's async generator finalization hooks,
+    which warn (and, under some async libraries such as trio, raise)
+    if it's garbage collected before being exhausted or explicitly
+    closed. Since callers may reasonably abandon iteration part way
+    through (e.g. the ``first`` filter, or a ``break`` in a loop), this
+    plain object avoids that tracking entirely.
+    """
+
+    __slots__ = ("_iterator",)
+
+    def __init__(self, iterable: "t.Iterable[V]") -> None:
+        self._iterator = iter(iterable)
+
+    def __aiter__(self) -> "t.AsyncIterator[V]":
+        return self
+
+    async def __anext__(self) -> V:
+        try:
+            return next(self._iterator)
+        except StopIteration as e:
+            raise StopAsyncIteration from e
+
+
+def auto_aiter(
     iterable: "t.Union[t.AsyncIterable[V], t.Iterable[V]]",
 ) -> "t.AsyncIterator[V]":
     if hasattr(iterable, "__aiter__"):
