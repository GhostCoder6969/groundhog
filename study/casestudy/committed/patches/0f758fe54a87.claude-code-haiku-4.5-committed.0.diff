         return meth
 
+    def converter(self, meth):
+        """
+        Decorator that adds *meth* to the converters.
+
+        Returns *meth* unchanged.
+        """
+        import inspect
+
+        sig = inspect.signature(meth)
+        params = list(sig.parameters.keys())
+
+        takes_self = "self" in params
+        takes_field = "field" in params
+
+        if takes_self and takes_field:
+            def wrapper(value, instance, field):
+                return meth(instance, field, value)
+            new_converter = Converter(wrapper, takes_self=True, takes_field=True)
+        else:
+            new_converter = Converter(meth, takes_self=takes_self, takes_field=takes_field)
+
+        # If _raw_converter is set, pipe the new converter with it
+        if self._raw_converter is not None:
+            # Wrap raw converter in a Converter if needed
+            if not isinstance(self._raw_converter, Converter):
+                raw_conv = Converter(self._raw_converter)
+            else:
+                raw_conv = self._raw_converter
+            self._converter = pipe(raw_conv, new_converter)
+        elif self._converter is None:
+            self._converter = new_converter
+        else:
+            self._converter = pipe(self._converter, new_converter)
+
+        return meth
 
 _CountingAttr = _add_eq(_add_repr(_CountingAttr))
 
