+class _PagerWriter:
+    """Wraps a pager stream and handles color stripping and proper stream lifecycle.
+
+    This wrapper:
+    - Strips ANSI codes when color=False
+    - Flushes the stream in close() but doesn't actually close borrowed streams
+    - Proxies other methods to the underlying stream
+    """
+    def __init__(self, stream: t.TextIO, *, color: bool):
+        self.stream = stream
+        self.color = color
+
+    def write(self, text: str) -> int:
+        if not self.color:
+            text = strip_ansi(text)
+        return self.stream.write(text)
+
+    def flush(self) -> None:
+        return self.stream.flush()
+
+    def close(self) -> None:
+        # Flush but don't close borrowed streams - each pager strategy owns the lifecycle
+        self.flush()
+
+    def __getattr__(self, name: str) -> t.Any:
+        return getattr(self.stream, name)
+
