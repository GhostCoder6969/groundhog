+def _has_less_raw_mode(less_flags_str: str) -> bool:
+    """Check if less flags string contains the -R or -r flag for raw mode.
+
+    Properly parses option tokens, ignoring filenames, option values, and
+    the -- option terminator.
+    """
+    # Try to parse with shlex first (which handles quotes properly)
+    try:
+        tokens = shlex.split(less_flags_str)
+    except ValueError:
+        # Fall back to whitespace splitting if shlex fails (e.g., unbalanced quotes)
+        tokens = less_flags_str.split()
+
+    for token in tokens:
+        # Stop processing after option terminator
+        if token == "--":
+            break
+
+        # Check for raw mode in short options (-R, -r, or bundled like -rX)
+        if token.startswith("-") and not token.startswith("--"):
+            # Short option form
+            if "r" in token or "R" in token:
+                return True
+        # Check for raw mode in long options (--raw-control-chars but not --raw-control-chars=value)
+        elif token.startswith("--"):
+            # Only match the bare option, not if it has a value attached (--option=value)
+            if "=" not in token and token.lower() == "--raw-control-chars":
+                return True
+
+    return False
+
