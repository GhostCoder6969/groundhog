+def detect_rust(repo: Path) -> Plan | None:
+    """Rust, via cargo, which every Rust project in practice uses.
+
+    Cargo.toml is enough: the toolchain is uniform, `cargo fetch` gets the
+    dependencies, and `cargo test` builds and runs them. Nothing needs parsing,
+    so a workspace root with no [package] of its own works the same way.
+    """
+    if not (repo / "Cargo.toml").is_file():
+        return None
+    return Plan(
+        language="rust",
+        install=["cargo fetch"],
+        # --no-fail-fast: cargo stops after the first target whose tests fail,
+        # which would hide every later target's outcomes -- and those outcomes
+        # are exactly what FAIL_TO_PASS and PASS_TO_PASS are computed from.
+        test_cmd="cargo test --no-fail-fast {tests}",
+        evidence=["Cargo.toml"],
+    )
+
+
