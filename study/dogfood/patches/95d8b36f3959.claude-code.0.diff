+# cargo prints one header per test binary ("Running unittests src/lib.rs (...)",
+# "Running tests/parse.rs (...)"), then one line per test underneath it.
+RUST_RUNNING = re.compile(r"^\s+Running (?:unittests )?(\S+\.rs)")
+RUST_DOCTESTS = re.compile(r"^\s+Doc-tests\b")
+# "test tests::add_works ... ok" -- the name may contain spaces for doctests
+# ("test src/lib.rs - add (line 5) ... ok"), so it is matched non-greedily.
+RUST_TEST_LINE = re.compile(r"^test (.+?) \.\.\. (ok|FAILED|ignored)\b")
+RUST_STATUS = {"ok": "PASSED", "FAILED": "FAILED", "ignored": "SKIPPED"}
+
+
+def rust_outcomes(output: str) -> dict[str, str]:
+    """Parse `cargo test` output into per-test outcomes.
+
+    Qualified by test target, for the same reason Go results are qualified by
+    package: the unit tests in src/lib.rs and the integration test in
+    tests/parse.rs may both define `parses_empty`, and a FAIL_TO_PASS set that
+    conflates them is wrong in a way nothing downstream can detect.
+
+    A compile error yields no headers and no test lines, so it yields {} -- which
+    is what makes "the tests failed" distinguishable from "nothing ran".
+    """
+    results: dict[str, str] = {}
+    target = "?"
+    for line in output.splitlines():
+        header = RUST_RUNNING.match(line)
+        if header:
+            # "src/lib.rs" -> lib, "tests/parse.rs" -> parse
+            target = Path(header.group(1)).stem
+            continue
+        if RUST_DOCTESTS.match(line):
+            target = "doc"
+            continue
+        test = RUST_TEST_LINE.match(line)
+        if test:
+            results[f"{target}::{test.group(1)}"] = RUST_STATUS[test.group(2)]
+    return results
+
+
 def test_targets(language: str, test_files: list[str]) -> str:
     """How to name the tests to run, for this language's test runner."""
     if language == "go":
         # Go runs packages, not files.
         dirs = sorted({str(Path(f).parent) for f in test_files})
         return " ".join(f"./{d}" if d != "." else "." for d in dirs)
+    if language == "rust":
+        # cargo runs test *targets*, not files. Only a file directly under the
+        # crate's tests/ dir is a target, named after its stem. Anything else --
+        # tests/common/mod.rs (a module of some target we cannot name), unit
+        # tests inside src/, a workspace member's tests/ -- has no name we can
+        # pass, so run the whole suite rather than silently run the wrong thing.
+        names = set()
+        for path in test_files:
+            parts = Path(path).parts
+            if len(parts) != 2 or parts[0] != "tests" or not parts[1].endswith(".rs"):
+                return ""
+            names.add(parts[1][:-3])
+        return " ".join(f"--test {name}" for name in sorted(names))
     return " ".join(test_files)
 
 
