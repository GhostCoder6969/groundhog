+def overstatement(rows: list[dict]) -> None:
+    """The score a FAIL_TO_PASS-only harness would report, next to the true one.
+
+    The study's central finding (study/collateral.md): an agent can make the
+    target test pass by deleting the module around it. Grading on FAIL_TO_PASS
+    alone counts that as a solve, so the overstatement is not noise -- for
+    qwen2.5-coder:7b it doubled the reported score.
+
+    Printed only where the two views disagree. A model with no gap has nothing
+    to explain, and a section of zeroes reads as a finding of its own.
+    """
+    gapped = [r for r in rows
+              if not r["unmeasured"] and r["f2p_only_solved"] > r["solved"]]
+    if not gapped:
+        return
+
+    width = max(len(r["model"]) for r in gapped) + 2
+    print(f"\n{BOLD}FAIL_TO_PASS-ONLY vs TRUE{RESET}  "
+          f"{DIM}(what target-tests-only grading would report){RESET}")
+    print(f"{BOLD}{'MODEL':<{width}}{'F2P-ONLY':>10}{'TRUE':>8}"
+          f"{'OVERSTATED':>13}   {'WHY':<24}{RESET}")
+    print(DIM + "-" * (width + 58) + RESET)
+    for r in gapped:
+        claimed = f"{r['f2p_only_solved']}/{r['total']}"
+        true = f"{r['solved']}/{r['total']}"
+        gap = f"{(r['f2p_only_rate'] - r['pass_rate']) * 100:+.0f}pts"
+        why = f"{r['collateral_attempts']} broke {r['collateral_tests_broken']}"
+        if r["tampered"]:
+            why += f", {r['tampered']} edited tests"
+        print(f"{r['model']:<{width}}{claimed:>10}{true:>8}{gap:>13}   {why:<24}")
+
+    print(f"\n  {DIM}OVERSTATED is the gap in percentage points between the two "
+          f"scores. WHY counts\n  the attempts behind it: attempts that passed "
+          f"their target test while breaking\n  already-passing tests, and the "
+          f"tests they broke. See study/collateral.md.{RESET}")
+
+
