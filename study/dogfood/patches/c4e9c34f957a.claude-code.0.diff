+def unstable(runs: list[dict[str, str]]) -> dict[str, list[str]]:
+    """Tests that did not report the same outcome in every run.
+
+    A test missing from a run counts as a disagreement too: a test that vanishes
+    because collection blew up is no more dependable than one that flips between
+    PASSED and FAILED.
+    """
+    names = sorted({name for run in runs for name in run})
+    flaky: dict[str, list[str]] = {}
+    for name in names:
+        seen = [run.get(name, "ABSENT") for run in runs]
+        if len(set(seen)) > 1:
+            flaky[name] = seen
+    return flaky
 
 
