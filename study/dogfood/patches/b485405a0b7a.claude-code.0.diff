+#!/usr/bin/env python3
+"""A shields.io endpoint badge for a run, for a README or a CI job.
+
+A badge is one number seen out of context, so it is the easiest place in this
+tool to state something the run does not support. Two rules follow: a model
+the harness could not read gets no percentage, only "not measured"; and the
+number always carries its denominator, because 100% (1/1) is not a score.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+
+from .report import short, summarise
+
+# shields.io named colours, coarse on purpose -- a badge is not a measurement.
+BANDS = ((0.80, "brightgreen"), (0.50, "green"), (0.30, "yellow"), (0.10, "orange"))
+
+
+def colour(rate: float) -> str:
+    for floor, name in BANDS:
+        if rate >= floor:
+            return name
+    return "red"
+
+
+def badge(rows: list[dict], model: str | None = None,
+          label: str = "agent pass rate") -> dict:
+    """Render one row as a shields.io endpoint payload.
+
+    With no model, the best measured one is used and its name goes in the
+    message -- a badge that hides which model it describes invites the reader
+    to assume it is the one they care about.
+    """
+    out = {"schemaVersion": 1, "label": label}
+
+    if model:
+        picked = next((r for r in rows if r["model"] == model or short(r["model"]) == model), None)
+        if picked is None:
+            return {**out, "message": f"no results for {model}", "color": "lightgrey",
+                    "isError": True}
+        if picked["unmeasured"]:
+            return {**out, "message": "not measured", "color": "lightgrey", "isError": True}
+        return {**out, "message": f"{picked['pass_rate']:.0%} "
+                                  f"({picked['solved']}/{picked['total']})",
+                "color": colour(picked["pass_rate"])}
+
+    # summarise() already sorts measured rows first, best rate first.
+    measured = [r for r in rows if not r["unmeasured"]]
+    if not measured:
+        return {**out, "message": "not measured", "color": "lightgrey", "isError": True}
+    best = measured[0]
+    return {**out, "message": f"{best['pass_rate']:.0%} "
+                              f"({best['solved']}/{best['total']}) · {short(best['model'])}",
+            "color": colour(best["pass_rate"])}
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--results", type=Path, default=Path("results/results.jsonl"))
+    ap.add_argument("--out", type=Path, default=Path("results/badge.json"))
+    ap.add_argument("--model", help="badge this model rather than the best measured one")
+    ap.add_argument("--label", default="agent pass rate")
+    cfg = ap.parse_args()
+
+    if not cfg.results.exists():
+        print(f"no results at {cfg.results}")
+        return 1
+    records = [json.loads(l) for l in cfg.results.read_text().splitlines() if l.strip()]
+    payload = badge(summarise(records), cfg.model, cfg.label)
+    cfg.out.parent.mkdir(parents=True, exist_ok=True)
+    cfg.out.write_text(json.dumps(payload, indent=2) + "\n")
+    print(f"wrote {cfg.out}: {payload['message']}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
