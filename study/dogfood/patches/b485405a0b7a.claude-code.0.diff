+def cell(text: str) -> str:
+    """Make a value safe to put in a Markdown table cell.
+
+    Commit subjects routinely contain a pipe, which would silently start a new
+    column and shift every mark in the row under the wrong model.
+    """
+    return str(text).replace("|", "\\|").replace("\n", " ")
+
+
+def markdown(rows: list[dict], records: list[dict], title: str = "Groundhog") -> str:
+    """The same report as `print_table`, as Markdown, with no escape codes.
+
+    This one goes somewhere a terminal is not: a PR comment, a CI job summary,
+    a README. It keeps the two refusals the table makes -- no percentage for a
+    model the harness could not read, and the F2P-only number never shown on
+    its own -- because those are the report, not decoration on it.
+    """
+    out = [f"### {title}", ""]
+    if not rows:
+        return "\n".join(out + ["No results.", ""])
+
+    out += ["| Model | Solved | Rate | 95% CI | Cost | Per solve | Median |",
+            "|---|---|---|---|---|---|---|"]
+    for r in rows:
+        if r["unmeasured"]:
+            out.append(f"| {cell(r['model'])} | {r['solved']}/{r['total']} | _not measured_ "
+                       f"| — | — | — | {r['median_seconds']:.0f}s |")
+            continue
+        band = f"{r['ci_low']:.0%} – {r['ci_high']:.0%}"
+        out.append(f"| {cell(r['model'])} | {r['solved']}/{r['total']} | {r['pass_rate']:.0%} "
+                   f"| {band} | {money(r['cost'])} | {money(r['cost_per_solve'])} "
+                   f"| {r['median_seconds']:.0f}s |")
+    out.append("")
+
+    for r in rows:
+        if r["unmeasured"]:
+            out += [f"> **{cell(r['model'])}**: {r['silent']} of {r['total']} attempts parsed "
+                    f"no tool call at all. That is a failed measurement, not a 0% score — the "
+                    f"model may be doing perfectly good work in a format this harness cannot "
+                    f"read. Widen the parser or exclude it before reporting anything about "
+                    f"this model.", ""]
+
+    ranked = [r for r in rows if not r["unmeasured"]]
+    if len(ranked) >= 2 and ranked[0]["ci_low"] < ranked[1]["ci_high"]:
+        need = tasks_needed(ranked[1]["pass_rate"],
+                            max(0.01, ranked[0]["pass_rate"] - ranked[1]["pass_rate"]))
+        out += [f"> The top two intervals overlap — this ordering is not a result. Separating "
+                f"them would need roughly {need} tasks (you have {ranked[0]['total']}), or a "
+                f"paired `groundhog compare`, which needs far fewer.", ""]
+
+    if any(r["f2p_only_solved"] > r["solved"] for r in ranked):
+        out += ["#### FAIL_TO_PASS-only vs true", "",
+                "| Model | F2P-only | True | Overstated | Collateral | Tests edited |",
+                "|---|---|---|---|---|---|"]
+        for r in ranked:
+            n = r["total"]
+            gap = (r["f2p_only_solved"] - r["solved"]) / n if n else 0.0
+            collateral = (f"{r['collateral_attempts']} broke {r['collateral_tests_broken']}"
+                          if r["collateral_attempts"] else "0")
+            out.append(f"| {cell(r['model'])} | {r['f2p_only_solved']}/{n} | {r['solved']}/{n} "
+                       f"| {f'+{gap * 100:.0f}pts' if gap else '0'} | {collateral} "
+                       f"| {r['tampered']} |")
+        out += ["",
+                "**F2P-only** is what a harness that checks only the target tests would have "
+                "reported. **True** also requires every previously-passing test to still pass "
+                "and no test file to have been edited. **Collateral** counts attempts that hit "
+                "the target and broke something else, with how many tests they broke.", ""]
+
+    tasks = sorted({r["task_id"]: r["subject"] for r in records}.items())
+    models = [r["model"] for r in rows]
+    unmeasured = {r["model"] for r in rows if r["unmeasured"]}
+    lookup = {(r["model"], r["task_id"]): r["solved"] for r in records}
+    out += ["#### Per task", "",
+            "| Task | " + " | ".join(cell(fit(label(m), 24)) for m in models) + " |",
+            "|---" * (len(models) + 1) + "|"]
+    for task_id, subject in tasks:
+        marks = []
+        for m in models:
+            ok = lookup.get((m, task_id))
+            # Neither a pass nor a fail: the model was never run on this task,
+            # or nothing it produced could be read.
+            marks.append("–" if m in unmeasured or ok is None else ("✅" if ok else "❌"))
+        out.append(f"| {cell(subject)} | " + " | ".join(marks) + " |")
+    out.append("")
+    return "\n".join(out)
+
+
