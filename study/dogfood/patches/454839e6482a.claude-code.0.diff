+@dataclass
+class Job:
+    """One attempt this run intends to make."""
+
+    model: str
+    run_index: int
+    index: int   # the task's 1-based position, for the progress line
+    task: dict
+
+
+def plan_attempts(tasks: list[dict], models: list[str], repeats: int,
+                  done: set[tuple[str, str, int]]) -> list[Job]:
+    """Every attempt still to make, in the order a sequential run makes them.
+
+    Ordering is model, then repeat, then task, so --jobs and a plain run
+    produce the same set of records -- the same (task, model, run_index)
+    triples, just finished in a different order.
+    """
+    return [
+        Job(model, run_index, i, task)
+        for model in models
+        for run_index in range(repeats)
+        for i, task in enumerate(tasks, 1)
+        if (task["sha"][:12], model, run_index) not in done
+    ]
+
+
+class Ledger:
+    """One writer, one budget, one tally, however many workers.
+
+    With --jobs the attempts finish in whatever order they like, so every
+    mutation of the results file and the running totals happens under a single
+    lock. Records are still written and flushed one at a time, which is what
+    --resume reads back.
+    """
+
+    def __init__(self, fh, cfg: argparse.Namespace, total_tasks: int, spent: float):
+        self.fh = fh
+        self.cfg = cfg
+        self.total_tasks = total_tasks
+        self.spent = spent
+        self.lock = threading.Lock()
+        self.records: list[Attempt] = []
+        self.skipped_for_budget = 0
+        self.unpriced: set[str] = set()
+        self.solved = 0
+        self.attempted = 0
+        # One worker can claim the line before it starts and finish it after.
+        # Several cannot, so in parallel the whole line is printed at the end.
+        self.streaming = cfg.jobs == 1
+
+    def begin(self) -> None:
+        """Start a fresh per-model tally."""
+        self.solved = self.attempted = 0
+
+    def run_one(self, job: Job) -> None:
+        tag = f" r{job.run_index + 1}" if self.cfg.repeats > 1 else ""
+        label = f"{job.model:<32}{tag} [{job.index}/{self.total_tasks}] {job.task['subject'][:34]}"
+        if self.streaming:
+            print(f"{label:<88}", end="", flush=True, file=sys.stderr)
+
+        with self.lock:
+            over = self.cfg.max_spend is not None and self.spent >= self.cfg.max_spend
+            if over:
+                self.skipped_for_budget += 1
+        if over:
+            self.report(label, "  SKIPPED (budget)")
+            return
+
+        rec = attempt(self.cfg.repo, job.task, job.model, self.cfg, job.run_index)
+
+        with self.lock:
+            self.records.append(rec)
+            self.fh.write(json.dumps(asdict(rec)) + "\n")
+            self.fh.flush()
+            if rec.cost_usd is None:
+                # A ceiling that silently never triggers is worse than none,
+                # so say so rather than assuming zero.
+                self.unpriced.add(rec.model)
+            else:
+                self.spent += rec.cost_usd
+            self.solved += rec.solved
+            self.attempted += 1
+        mark = "PASS" if rec.solved else ("ERROR" if rec.error else "fail")
+        self.report(label, f"  {mark:<5} {rec.seconds:>6.1f}s  {rec.error[:40]}")
+
+    def report(self, label: str, outcome: str) -> None:
+        print(outcome if self.streaming else f"{label:<88}{outcome}", file=sys.stderr)
+
+
+def execute(plan: list[Job], models: list[str], ledger: Ledger, jobs: int) -> None:
+    """Work the plan, a model at a time, up to `jobs` attempts at once.
+
+    Each model's batch is drained before the next starts so its summary line
+    still means what it says. Within a batch the attempts are independent:
+    every one builds its own git worktree and its own temporary tree.
+    """
+    for model in models:
+        batch = [job for job in plan if job.model == model]
+        ledger.begin()
+        if jobs > 1 and len(batch) > 1:
+            with ThreadPoolExecutor(max_workers=min(jobs, len(batch))) as pool:
+                list(pool.map(ledger.run_one, batch))
+        else:
+            for job in batch:
+                ledger.run_one(job)
+        print(f"{model:<32} -> {ledger.solved}/{ledger.attempted}\n", file=sys.stderr)
+
+
