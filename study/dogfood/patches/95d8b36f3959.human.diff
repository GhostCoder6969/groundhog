+        # --no-fail-fast so every target reports, not just the first to fail.
+        test_cmd="cargo test --no-fail-fast {tests}",
+        evidence=["Cargo.toml"],
+        notes=["integration tests under tests/ only; in-file #[cfg(test)] modules cannot be mined"],
+    )
+
