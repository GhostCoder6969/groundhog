+def reads_tool_calls(attempt: dict) -> bool:
+    """Whether a missing tool call says anything about this attempt.
+
+    The silence check reads the tool calls the built-in loop parsed. An
+    external agent runs its own loop behind a shell, so Groundhog records no
+    tool stats for it at all -- and reading that absence as silence reports
+    every external agent as a failed measurement.
+    """
+    return (attempt.get("agent") or "builtin") == "builtin"
+
