+def _toml(text: str) -> dict:
+    parser = _toml_parser()
+    if parser is None:
         return {}
     try:
-        return tomllib.loads(text)
+        return parser.loads(text)
     except Exception:
         return {}
 
@@ -268,6 +286,11 @@ def detect(repo: Path) -> Plan:
