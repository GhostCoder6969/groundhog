-def _toml(text: str) -> dict:
+def _toml_parser():
+    """tomllib on 3.11+, tomli if someone installed it, else None."""
     try:
         import tomllib
-    except ModuleNotFoundError:  # pragma: no cover - py3.10
+        return tomllib
+    except ModuleNotFoundError:
+        try:
+            import tomli
+            return tomli
