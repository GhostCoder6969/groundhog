+def system_prompt(cfg: argparse.Namespace) -> str:
+    """The system prompt this run is configured with, default or overridden."""
+    return getattr(cfg, "system_prompt_text", None) or SYSTEM
+
+
+def prompt_fingerprint(text: str) -> str:
+    """Short digest of a prompt, recorded on every attempt.
+
+    A prompt ablation produces results files that are otherwise identical --
+    same repo, same tasks, same model -- and nothing in a row says which
+    wording produced it. Twelve hex characters is enough to group and compare
+    them months later, when the prompt itself has moved on.
+    """
+    return hashlib.sha256(text.encode()).hexdigest()[:12]
+
+
+def sample_tasks(tasks: list[dict], count: int, seed: int) -> list[dict]:
+    """A reproducible subset: same seed and same corpus, same tasks.
+
+    Sorted by sha first, so the draw does not depend on the order the mining
+    step happened to write the file in.
+    """
+    if count <= 0 or count >= len(tasks):
+        return tasks
+    ordered = sorted(tasks, key=lambda t: t.get("sha", ""))
+    return random.Random(seed).sample(ordered, count)
+
